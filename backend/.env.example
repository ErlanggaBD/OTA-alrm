# Server
PORT=3000
PUBLIC_BASE_URL=http://192.168.1.10:3000

# SQLite database and firmware storage
DB_PATH=./data/medgas.sqlite
FIRMWARE_DIR=./data/firmware

# 32+ byte secret used to encrypt device secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=change-me-to-a-random-64-char-hex-string

# Admin bootstrap (used by npm run seed)
ADMIN_USER=admin
ADMIN_PASS=admin123

# Express session secret
SESSION_SECRET=change-me-to-another-random-string

# Provisioning policy
# true  = any email can self-register (demo only)
# false = device must already exist in admin UI, or present PROVISION_KEY
ALLOW_SELF_REGISTER=true
PROVISION_KEY=

# HMAC / config cache
HMAC_WINDOW_SEC=300
CONFIG_TTL_SEC=86400
